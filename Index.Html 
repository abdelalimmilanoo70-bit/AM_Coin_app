<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>AM COIN Mining</title>
  <style>
    :root {
      --bg-color: #0d1117;
      --card-bg: #161b22;
      --accent-color: #00f2fe;
      --text-color: #ffffff;
      --subtext: #8b949e;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    .header {
      padding: 20px;
      text-align: center;
      background: var(--card-bg);
      border-bottom: 1px solid #30363d;
    }

    .balance-title {
      font-size: 14px;
      color: var(--subtext);
    }

    .balance {
      font-size: 36px;
      font-weight: bold;
      color: var(--accent-color);
      margin-top: 5px;
    }

    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .coin-button {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 30px rgba(0, 242, 254, 0.4);
      cursor: pointer;
      transition: transform 0.05s ease;
      position: relative;
    }

    .coin-button:active {
      transform: scale(0.95);
    }

    .coin-text {
      font-size: 48px;
      font-weight: 900;
      color: #000;
      letter-spacing: 2px;
    }

    .energy-container {
      width: 80%;
      margin-bottom: 30px;
      text-align: center;
    }

    .energy-bar-bg {
      width: 100%;
      height: 12px;
      background: #30363d;
      border-radius: 6px;
      overflow: hidden;
      margin-top: 8px;
    }

    .energy-bar-fill {
      height: 100%;
      width: 100%;
      background: var(--accent-color);
      transition: width 0.2s ease;
    }

    .floating-text {
      position: absolute;
      font-size: 24px;
      font-weight: bold;
      color: #fff;
      pointer-events: none;
      animation: floatUp 0.8s ease-out forwards;
    }

    @keyframes floatUp {
      0% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(-50px); }
    }
  </style>
</head>
<body>

  <div class="header">
    <div class="balance-title">رصيدك من عملة AM</div>
    <div class="balance" id="balance">0 AM</div>
  </div>

  <div class="main-content" id="mainArea">
    <div class="coin-button" id="coinBtn">
      <span class="coin-text">AM</span>
    </div>
  </div>

  <div class="energy-container">
    <div>⚡ الطاقة: <span id="energyText">1000 / 1000</span></div>
    <div class="energy-bar-bg">
      <div class="energy-bar-fill" id="energyFill"></div>
    </div>
  </div>

  <script>
    let balance = parseFloat(localStorage.getItem('am_balance')) || 0;
    let energy = parseInt(localStorage.getItem('am_energy')) || 1000;
    const maxEnergy = 1000;

    const balanceEl = document.getElementById('balance');
    const energyTextEl = document.getElementById('energyText');
    const energyFillEl = document.getElementById('energyFill');
    const coinBtn = document.getElementById('coinBtn');
    const mainArea = document.getElementById('mainArea');

    function updateUI() {
      balanceEl.textContent = balance.toLocaleString() + ' AM';
      energyTextEl.textContent = `${energy} / ${maxEnergy}`;
      energyFillEl.style.width = `${(energy / maxEnergy) * 100}%`;
    }

    coinBtn.addEventListener('click', (e) => {
      if (energy <= 0) return;

      balance += 1;
      energy -= 1;

      localStorage.setItem('am_balance', balance);
      localStorage.setItem('am_energy', energy);

      // تأثير الرقم الصاعد (+1)
      const rect = coinBtn.getBoundingClientRect();
      const floatEl = document.createElement('div');
      floatEl.className = 'floating-text';
      floatEl.textContent = '+1';
      floatEl.style.left = `${e.clientX - rect.left + 80}px`;
      floatEl.style.top = `${e.clientY - rect.top}px`;
      
      mainArea.appendChild(floatEl);
      setTimeout(() => floatEl.remove(), 800);

      updateUI();
    });

    // إعادة شحن الطاقة تلقائياً كل ثانية
    setInterval(() => {
      if (energy < maxEnergy) {
        energy = Math.min(maxEnergy, energy + 2);
        localStorage.setItem('am_energy', energy);
        updateUI();
      }
    }, 1000);

    updateUI();
  </script>
</body>
</html>
